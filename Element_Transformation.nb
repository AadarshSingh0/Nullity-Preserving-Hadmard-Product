Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"generateMatrix2", "[", 
    RowBox[{"n_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"j", "==", "i"}], ",", 
       RowBox[{
        RowBox[{"a", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", "j", ")"}]}], "j"}], ")"}]}], 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "a", " ", "i"}], "]"}]}], ",", 
       RowBox[{"j", "==", 
        RowBox[{"i", "+", "1"}]}], ",", 
       RowBox[{"0", "*", 
        RowBox[{"a", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", 
            RowBox[{"(", "j", ")"}]}], "j"}], ")"}]}], 
        RowBox[{"Sin", "[", " ", 
         RowBox[{"2", "a", " ", "i"}], "]"}]}], ",", 
       RowBox[{"j", "==", 
        RowBox[{"i", "-", "1"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"a", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", 
             RowBox[{"(", "j", ")"}]}], "j"}], ")"}]}]}], 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "a", " ", "i"}], "]"}]}], ",", "True", ",", "0"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"n", "+", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
