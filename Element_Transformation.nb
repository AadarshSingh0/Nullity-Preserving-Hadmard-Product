Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"massData1", "=", 
    RowBox[{"{", "}"}]}], ";", 
   RowBox[{"(*", 
    RowBox[{"Initialize", " ", "storage"}], "*)"}], 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"nsite", "=", "n"}], ";", 
       RowBox[{"(*", 
        RowBox[{"Use", " ", "loop", " ", "variable", " ", "n"}], "*)"}], 
       RowBox[{"lam", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"m1", "=", 
        RowBox[{"generateMatrix3", "[", 
         RowBox[{"nsite", ",", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"u1", ",", "w1", ",", "v1"}], "}"}], "=", 
        RowBox[{"SingularValueDecomposition", "[", 
         RowBox[{"Transpose", "[", "m1", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n1", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"u1", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"finalMatrix1", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Sequence", "@@", 
              RowBox[{"u1", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "}"}], ",", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"u1", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "}"}], "]"}], ",", 
            RowBox[{"w1", "+", 
             RowBox[{"lam", "*", 
              RowBox[{"IdentityMatrix", "[", "nsite", "]"}]}]}], ",", "2"}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"singularValues1", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"SingularValueDecomposition", "[", "finalMatrix1", "]"}], 
          "[", 
          RowBox[{"[", "2", "]"}], "]"}], "//", "Diagonal"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"massData1", ",", 
         RowBox[{
          RowBox[{"v", "^", "2"}], "*", 
          RowBox[{"singularValues1", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}]}]}], "]"}], ";"}], ")"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "5", ",", "30"}], "}"}]}], "     ", 
    RowBox[{"(*", 
     RowBox[{
     "Loop", " ", "variable", " ", "n", " ", "from", " ", "5", " ", "to", " ",
       "40"}], "*)"}], "]"}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.975847058956458*^9, 3.975847142180372*^9}, {
