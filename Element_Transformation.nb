Cell[BoxData[
 RowBox[{
  RowBox[{"generateMatrix2", "[", 
   RowBox[{"n_", ",", "a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"j", "==", "i"}], ",", "1.", ",", 
      RowBox[{"j", "==", 
       RowBox[{"i", "+", "1"}]}], ",", 
      RowBox[{"Sin", "[", " ", 
       RowBox[{"2", " ", "b", " ", "i"}], "]"}], ",", 
      RowBox[{"j", "==", 
       RowBox[{"i", "-", "1"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", "b", " ", "i"}], "]"}], "^", 
       RowBox[{"-", "1"}]}], ",", "True", ",", "0"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "n"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.975927647424526*^9, 3.975927648049945*^9}},
 CellLabel->
  "In[536]:=",ExpressionUUID->"d6ee5e38-fe6a-4ad8-8985-b935a747d24c"],

