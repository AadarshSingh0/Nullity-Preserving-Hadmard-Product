Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "parameters"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", "1"}], ";", 
    RowBox[{"b", "=", "2"}], ";", 
    RowBox[{"c", "=", "3"}], ";", 
    RowBox[{"n", "=", "13"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataPlus", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"a", "+", 
          RowBox[{"2", "*", "b", "*", "c", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"k", "*", 
             RowBox[{"Pi", "/", 
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}]}]}], "]"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dataMinus", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"a", "-", 
          RowBox[{"2", "*", "b", "*", "c", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"k", "*", 
             RowBox[{"Pi", "/", 
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}]}]}], "]"}]}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "both", " ", "sequences"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dataPlus", ",", "dataMinus"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
     
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<a + 2bc Cos[k\[Pi]/(n+1)]\>\"", ",", 
        "\"\<a - 2bc Cos[k\[Pi]/(n+1)]\>\""}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<k\>\"", ",", "\"\<f(k)\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Discrete values of a \[PlusMinus] 2bc Cos[k\[Pi]/(n+1)]\>\""}], 
     ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}]], "Input",
