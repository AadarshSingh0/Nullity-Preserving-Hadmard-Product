Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generateMatrix2", "[", 
     RowBox[{"n_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"j", "==", "i"}], ",", 
        RowBox[{
         RowBox[{"a", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", 
             RowBox[{"(", "j", ")"}]}], "j"}], ")"}]}], 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "a", " ", "i"}], "]"}]}], ",", 
        RowBox[{"j", "==", 
         RowBox[{"i", "+", "1"}]}], ",", 
        RowBox[{
         RowBox[{"a", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", 
             RowBox[{"(", "j", ")"}]}], "j"}], ")"}]}], 
         RowBox[{"Sin", "[", " ", 
          RowBox[{"2", "a", " ", "i"}], "]"}]}], ",", 
        RowBox[{"j", "==", 
         RowBox[{"i", "-", "1"}]}], ",", 
        RowBox[{
         RowBox[{"a", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", 
             RowBox[{"(", "j", ")"}]}], "j"}], ")"}]}], 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "a", " ", "i"}], "]"}]}], ",", "True", ",", "0"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Example", " ", "usage", " ", "with", " ", "your", " ", 
      RowBox[{"substitution", ":", "a"}]}], "=", "1"}], ",", 
    RowBox[{"b", "=", "1"}], ",", 
    RowBox[{"c", "=", "1"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"m1", "=", 
   RowBox[{"generateMatrix2", "[", 
