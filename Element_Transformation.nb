Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Combined", " ", "loop"}], "-", 
    RowBox[{"Initialize", " ", "storage"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"massData1", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"massData2", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lam", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"nsite", "=", "n"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"First", " ", "calculation"}], "-", "generateMatrix3"}], 
         "*)"}], 
        RowBox[{"lam1", "=", "lam"}], ";", "\[IndentingNewLine]", 
        RowBox[{"m1", "=", 
         RowBox[{"generateMatrix3", "[", 
          RowBox[{"nsite", ",", "a"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u1", ",", "w1", ",", "v1"}], "}"}], "=", 
         RowBox[{"SingularValueDecomposition", "[", 
          RowBox[{"Transpose", "[", "m1", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n1", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"u1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"finalMatrix1", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"u1", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "}"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"u1", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "}"}], "]"}], ",", 
             RowBox[{"w1", "+", 
              RowBox[{"lam1", "*", 
               RowBox[{"IdentityMatrix", "[", "nsite", "]"}]}]}], ",", "2"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"singularValues1", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"SingularValueDecomposition", "[", "finalMatrix1", "]"}], 
           "[", 
           RowBox[{"[", "2", "]"}], "]"}], "//", "Diagonal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"massData1", ",", 
          RowBox[{
           RowBox[{"v", "^", "2"}], "*", 
           RowBox[{"singularValues1", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Second", " ", "calculation"}], "-", "generateMatrix2"}], 
         "*)"}], 
        RowBox[{"Clear", "[", "b", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"lam2", "=", "lam"}], ";", "\[IndentingNewLine]", 
        RowBox[{"m2", "=", 
         RowBox[{"generateMatrix2", "[", 
          RowBox[{"nsite", ",", "a", ",", "b"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u2", ",", "w2", ",", "v2"}], "}"}], "=", 
         RowBox[{"SingularValueDecomposition", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "m2", "]"}], "/.", " ", 
           RowBox[{"{", 
            RowBox[{"b", "->", "1.03"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n2", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"u2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"finalMatrix2", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"Sequence", "@@", 
               RowBox[{"u2", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "}"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"u2", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "}"}], "]"}], ",", 
             RowBox[{"w2", "+", 
              RowBox[{"lam2", "*", 
               RowBox[{"IdentityMatrix", "[", "nsite", "]"}]}]}], ",", "2"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"singularValues2", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"SingularValueDecomposition", "[", "finalMatrix2", "]"}], 
           "[", 
           RowBox[{"[", "2", "]"}], "]"}], "//", "Diagonal"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"massData2", ",", 
          RowBox[{
           RowBox[{"v", "^", "2"}], "*", 
           RowBox[{"singularValues2", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}]}], "]"}], ";"}], ")"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "5", ",", "80"}], "}"}]}], "]"}], ";"}], 
